# Frontend
NODE_ENV=production
# For HTTPS via Nginx in container, frontend can still call backend via same host.
# Leave unset to auto-resolve. For fixed upstream use full URL.
NEXT_PUBLIC_BACKEND_URL=
# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
DEBUG=false
 
# Nginx / HTTPS (Docker only)
# Set the server's public IP or DNS name for the SSL server_name
SERVER_IP=10.11.36.40
# SSL certs are bundled in /certs and copied into the image. Paths below are defaults.
NGINX_SSL_CERT=/etc/nginx/certs/10.11.36.40.pem
NGINX_SSL_KEY=/etc/nginx/certs/10.11.36.40-key.pem
# SPS OPC UA
OPC_UA_SERVER_URL=opc.tcp://192.168.18.8:4840
OPC_UA_NODE_ID=ns=2;s=.G_HMI.stCM.sFormatAktiv
OPC_UA_ENABLED=false
# RFID
RFID_OPC_ENABLED=false
RFID_OPC_SERVER_URL=opc.tcp://10.11.36.216:4840
RFID_OPC_NODE_ID=ns=4;i=6023 # Last read RFID tag
# Event RFID OPC UA
OPC_UA_EVENT_ENABLED=false
OPC_UA_EVENT_SERVER_URL=opc.tcp://10.11.36.216:4840
OPC_UA_EVENT_TYPE=ns=4;i=6050
OPC_UA_EVENT_INTERVAL_MS=500
OPC_UA_EVENT_MAX_EVENTS=500
# Database
DATABASE_URL=sqlite:///app/data/rfid_assignments.db