{
  "name": "rfid-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --turbopack",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "backend": "python backend/main.py",
    "dev:all": "concurrently \"npm run dev\" \"npm run backend\"",
    "setup:backend": "cd backend && pip install -r requirements.txt",
    "docker:build": "docker build -t rfid-app .",
    "docker:run": "docker run -p 3000:3000 -p 8001:8001 rfid-app",
    "docker:compose": "docker-compose up --build",
    "docker:stop": "docker-compose down",
    "start:all": "concurrently \"npm run dev\" \"npm run backend\" --names \"FRONTEND,BACKEND\" --prefix-colors \"cyan,yellow\""
  },
  "dependencies": {
    "next": "^16.2.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.6"
  },
  "overrides": {
    "postcss": "^8.5.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4",
    "typescript": "^6"
  }
}
