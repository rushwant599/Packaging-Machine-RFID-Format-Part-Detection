# Frontend
NODE_ENV=production
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001
# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
DEBUG=false
# SPS OPC UA
OPC_UA_SERVER_URL=opc.tcp://192.168.18.8:4840
OPC_UA_NODE_ID=ns=2;s=.G_HMI.stCM.sFormatAktiv
OPC_UA_ENABLED=true
# RFID
RFID_OPC_ENABLED=false
RFID_OPC_SERVER_URL=opc.tcp://10.11.36.216:4840
RFID_OPC_NODE_ID=ns=4;i=6023 # Last read RFID tag
# Event RFID OPC UA
OPC_UA_EVENT_ENABLED=true
OPC_UA_EVENT_SERVER_URL=RFID_OPC_SERVER_URL
OPC_UA_EVENT_TYPE=ns=4;i=6050
OPC_UA_EVENT_INTERVAL_MS=500
OPC_UA_EVENT_MAX_EVENTS=500
# TCP/IP RFID
RFID_INVENTORY_ENABLED=False
RFID_READER_IP=""
RFID_READER_PORT=2111
RFID_READER_ANT="F"
RFID_CURRENT_RETENTION_SEC=10
RFID_INVENTORY_INTERVAL_SEC=1
# Database
DATABASE_URL=sqlite:///app/data/rfid_assignments.db